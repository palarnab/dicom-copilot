{
  "name": "mcp-dicom-copilot",
  "version": "1.0.0",
  "description": "MCP Server - DICOM Metadata, Conformance & PHI Copilot for VS Code (local-first, PHI-safe)",
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/index.js",
    "start:stdio": "node src/index.js --transport stdio",
    "dev": "node --watch src/index.js",
    "dev:stdio": "node --watch src/index.js --transport stdio",
    "test:smoke": "node scripts/smoke-test.js",
    "test": "npm run test:smoke"
  },
  "keywords": [
    "mcp",
    "dicom",
    "copilot",
    "vscode",
    "medical-imaging",
    "phi",
    "de-identification",
    "pacs",
    "healthcare",
    "radiology"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "dicom-parser": "^1.8.21",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {}
}
